<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <!-- Gradients -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="60%" stop-color="#edf2f7" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>

    <linearGradient id="wallSunlight" x1="0%" y1="0%" x2="70%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
      <stop offset="40%" stop-color="#fdfcf7" stop-opacity="0.5" />
      <stop offset="100%" stop-color="#f1f5f9" stop-opacity="0" />
    </linearGradient>

    <linearGradient id="woodFloor" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#d97706" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#92400e" stop-opacity="0.45" />
    </linearGradient>

    <linearGradient id="screenGlass" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>

    <linearGradient id="suitGrad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="40%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#090d16" />
    </linearGradient>

    <linearGradient id="tieGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1d4ed8" />
      <stop offset="100%" stop-color="#1e40af" />
    </linearGradient>

    <linearGradient id="cardBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <linearGradient id="cardGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>

    <linearGradient id="cardOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <linearGradient id="cardPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#6d28d9" />
    </linearGradient>

    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.18" />
    </filter>

    <filter id="boardGlow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#1e3a8a" flood-opacity="0.25" />
    </filter>
  </defs>

  <!-- ================= CLASSROOM BACKGROUND ================= -->
  <rect width="1600" height="900" fill="url(#bgGrad)" />
  
  <!-- Wood Flooring Perspective in Lower Half -->
  <path d="M 0 620 L 1600 620 L 1600 900 L 0 900 Z" fill="#fdfbf7" />
  <path d="M 0 640 L 1600 640 L 1600 900 L 0 900 Z" fill="url(#woodFloor)" />

  <!-- Window on Left Wall with Natural Daylight -->
  <g transform="translate(0, 0)">
    <!-- Sunlight overlay beam -->
    <polygon points="0,40 240,40 480,900 0,900" fill="url(#wallSunlight)" opacity="0.65" />
    
    <!-- Window Frame -->
    <rect x="-10" y="40" width="150" height="420" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="8" />
    <line x1="65" y1="40" x2="65" y2="460" stroke="#cbd5e1" stroke-width="5" />
    <line x1="-10" y1="180" x2="140" y2="180" stroke="#cbd5e1" stroke-width="5" />
    <line x1="-10" y1="320" x2="140" y2="320" stroke="#cbd5e1" stroke-width="5" />
    
    <!-- Sunny day glass tints -->
    <rect x="-6" y="44" width="67" height="132" fill="#e0f2fe" opacity="0.8" />
    <rect x="69" y="44" width="67" height="132" fill="#bae6fd" opacity="0.8" />
    <rect x="-6" y="184" width="67" height="132" fill="#e0f2fe" opacity="0.75" />
    <rect x="69" y="184" width="67" height="132" fill="#bae6fd" opacity="0.75" />
    <rect x="-6" y="324" width="67" height="132" fill="#e0f2fe" opacity="0.7" />
    <rect x="69" y="324" width="67" height="132" fill="#bae6fd" opacity="0.7" />

    <!-- Green Potted Plant on Window Sill -->
    <rect x="15" y="450" width="115" height="16" rx="2" fill="#ffffff" stroke="#94a3b8" stroke-width="2" />
    <!-- White ceramic plant pot -->
    <polygon points="40,410 75,410 70,450 45,450" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />
    <!-- Lush plant leaves -->
    <ellipse cx="44" cy="390" rx="14" ry="24" fill="#22c55e" transform="rotate(-30 44 390)" />
    <ellipse cx="72" cy="392" rx="14" ry="24" fill="#16a34a" transform="rotate(30 72 392)" />
    <ellipse cx="58" cy="376" rx="12" ry="26" fill="#4ade80" />
    <ellipse cx="52" cy="396" rx="10" ry="18" fill="#15803d" />
  </g>

  <!-- Classroom Bookshelf in Background (Mid-Left) -->
  <g transform="translate(350, 48)">
    <rect x="0" y="0" width="130" height="230" rx="3" fill="#e2d4be" stroke="#cbb89d" stroke-width="6" />
    <line x1="0" y1="80" x2="130" y2="80" stroke="#cbb89d" stroke-width="6" />
    <line x1="0" y1="160" x2="130" y2="160" stroke="#cbb89d" stroke-width="6" />
    
    <!-- Top Shelf Books -->
    <rect x="8" y="18" width="16" height="58" rx="2" fill="#ef4444" />
    <rect x="26" y="12" width="18" height="64" rx="2" fill="#3b82f6" />
    <rect x="46" y="24" width="14" height="52" rx="2" fill="#10b981" />
    <rect x="62" y="10" width="20" height="66" rx="2" fill="#f59e0b" />
    <rect x="84" y="20" width="16" height="56" rx="2" fill="#8b5cf6" />
    <rect x="102" y="26" width="18" height="50" rx="2" fill="#06b6d4" />

    <!-- Middle Shelf Books -->
    <rect x="10" y="94" width="22" height="62" rx="2" fill="#0284c7" />
    <rect x="34" y="102" width="16" height="54" rx="2" fill="#ec4899" />
    <rect x="52" y="90" width="20" height="66" rx="2" fill="#84cc16" />
    <rect x="74" y="98" width="18" height="58" rx="2" fill="#6366f1" />
    <rect x="94" y="92" width="24" height="64" rx="2" fill="#f97316" />
  </g>

  <!-- ================= EDUSMART WALL BRANDING (LEFT WALL) ================= -->
  <g transform="translate(170, 20)">
    <!-- Brand Emblem: Mortarboard & Book -->
    <g transform="translate(50, 0)">
      <!-- Mortarboard Cap -->
      <polygon points="60,10 115,35 60,54 5,35" fill="#0284c7" />
      <path d="M 32 44 Q 60 60 88 44 L 86 58 Q 60 70 34 58 Z" fill="#0369a1" />
      <!-- Tassel -->
      <path d="M 60,35 Q 105,38 110,60 L 112,78" stroke="#f59e0b" stroke-width="3" fill="none" />
      <circle cx="112" cy="80" r="3" fill="#f59e0b" />
      <!-- Open Book Base -->
      <path d="M 12 70 Q 60 62 108 70 L 100 84 Q 60 76 20 84 Z" fill="#f59e0b" />
      <path d="M 16 84 Q 60 76 104 84 L 98 94 Q 60 86 22 94 Z" fill="#0284c7" />
    </g>

    <!-- Brand Typography: EduSmart -->
    <text x="60" y="145" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="900" font-size="44" letter-spacing="-1" text-anchor="middle">
      <tspan fill="#0284c7">Edu</tspan><tspan fill="#f59e0b">Smart</tspan>
    </text>

    <!-- Subtitle: Smart Learning. Better Management. -->
    <text x="60" y="174" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="800" font-size="15" fill="#334155" text-anchor="middle">
      Smart Learning.
    </text>
    <text x="60" y="196" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="800" font-size="15" fill="#334155" text-anchor="middle">
      Better Management.
    </text>
  </g>

  <!-- ================= MOTIVATIONAL RIGHT WALL SLOGAN ================= -->
  <g transform="translate(1420, 110)">
    <text x="40" y="30" font-family="'Caveat', 'Brush Script MT', cursive, sans-serif" font-size="48" font-weight="700" fill="#0284c7" text-anchor="middle" transform="rotate(-5)">
      Learn
    </text>
    <text x="40" y="90" font-family="'Caveat', 'Brush Script MT', cursive, sans-serif" font-size="52" font-weight="700" fill="#0369a1" text-anchor="middle" transform="rotate(-3)">
      Grow
    </text>
    <text x="40" y="155" font-family="'Caveat', 'Brush Script MT', cursive, sans-serif" font-size="56" font-weight="700" fill="#075985" text-anchor="middle" transform="rotate(-6)">
      Succeed
    </text>
  </g>

  <!-- ================= INTERACTIVE DIGITAL SMART BOARD (CENTER-RIGHT) ================= -->
  <g transform="translate(440, 25)" filter="url(#boardGlow)">
    <!-- Board Outer Bezel -->
    <rect x="0" y="0" width="700" height="440" rx="16" fill="#090d16" stroke="#334155" stroke-width="8" />
    
    <!-- Screen Surface (White/Light Canvas of Portal) -->
    <rect x="8" y="8" width="684" height="424" rx="10" fill="#f8fafc" />

    <!-- 1. Screen Top Header Bar -->
    <rect x="8" y="8" width="684" height="44" rx="10" fill="#ffffff" />
    <line x1="8" y1="52" x2="692" y2="52" stroke="#e2e8f0" stroke-width="1.5" />

    <!-- EduSmart Emblem & Name in Header -->
    <g transform="translate(24, 20)">
      <polygon points="12,2 23,7 12,12 1,7" fill="#0284c7" />
      <path d="M 2 13 Q 12 11 22 13 L 20 16 Q 12 14 4 16 Z" fill="#f59e0b" />
      <text x="30" y="14" font-family="system-ui, sans-serif" font-weight="900" font-size="16" fill="#0284c7">Edu<tspan fill="#f59e0b">Smart</tspan></text>
    </g>

    <!-- Top Right Profile: Mr. Gadaffih / Teacher -->
    <g transform="translate(540, 15)">
      <!-- Avatar Circle -->
      <circle cx="16" cy="16" r="14" fill="#0284c7" />
      <text x="16" y="21" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff" text-anchor="middle">MG</text>
      <!-- Name & Role -->
      <text x="36" y="14" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#0f172a">Mr. Gadaffih</text>
      <text x="36" y="25" font-family="system-ui, sans-serif" font-weight="600" font-size="9" fill="#64748b">Teacher</text>
    </g>

    <!-- 2. Portal Left Sidebar -->
    <rect x="8" y="52" width="140" height="380" fill="#0284c7" />
    
    <!-- Sidebar Nav Links -->
    <g transform="translate(20, 68)" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" font-weight="700">
      <rect x="-4" y="-2" width="124" height="22" rx="6" fill="#ffffff" fill-opacity="0.2" />
      <text x="16" y="13">📊 Dashboard</text>
      
      <text x="16" y="38" opacity="0.9">📅 Timetable</text>
      <text x="16" y="62" opacity="0.9">💻 eLearning</text>
      <text x="16" y="86" opacity="0.9">📝 Assessments</text>
      <text x="16" y="110" opacity="0.9">📚 Homework</text>
      <text x="16" y="134" opacity="0.9">💬 Communication</text>
      <text x="16" y="158" opacity="0.9">📈 Analytics</text>
      <text x="16" y="182" opacity="0.9">⚙️ Settings</text>
    </g>

    <!-- 3. Portal Main Dashboard Body -->
    <g transform="translate(160, 62)">
      <!-- Welcome Header -->
      <text x="12" y="24" font-family="system-ui, sans-serif" font-weight="900" font-size="18" fill="#0f172a">
        Good Morning, Teacher!
      </text>
      <text x="12" y="39" font-family="system-ui, sans-serif" font-weight="600" font-size="11" fill="#64748b">
        Together we build brighter futures.
      </text>

      <!-- 4 Dashboard Metric Tiles -->
      <g transform="translate(12, 50)">
        <!-- Tile 1: My Classes (Blue) -->
        <rect x="0" y="0" width="115" height="74" rx="8" fill="url(#cardBlue)" />
        <text x="12" y="28" font-size="20">👥</text>
        <text x="12" y="48" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff">My Classes</text>
        <text x="12" y="63" font-family="system-ui, sans-serif" font-weight="900" font-size="12" fill="#dbeafe">5 Classes</text>

        <!-- Tile 2: Students (Green) -->
        <rect x="125" y="0" width="115" height="74" rx="8" fill="url(#cardGreen)" />
        <text x="137" y="28" font-size="20">🎓</text>
        <text x="137" y="48" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff">Students</text>
        <text x="137" y="63" font-family="system-ui, sans-serif" font-weight="900" font-size="12" fill="#d1fae5">120 Active</text>

        <!-- Tile 3: Assignments (Orange) -->
        <rect x="250" y="0" width="115" height="74" rx="8" fill="url(#cardOrange)" />
        <text x="262" y="28" font-size="20">📋</text>
        <text x="262" y="48" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff">Assignments</text>
        <text x="262" y="63" font-family="system-ui, sans-serif" font-weight="900" font-size="12" fill="#fef3c7">8 Pending</text>

        <!-- Tile 4: eLearning (Purple) -->
        <rect x="375" y="0" width="125" height="74" rx="8" fill="url(#cardPurple)" />
        <text x="387" y="28" font-size="20">💻</text>
        <text x="387" y="48" font-family="system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff">eLearning</text>
        <text x="387" y="63" font-family="system-ui, sans-serif" font-weight="900" font-size="12" fill="#ede9fe">12 Resources</text>
      </g>

      <!-- 5. Lower Content Split: Schedule & Quick Links -->
      <g transform="translate(12, 138)">
        <!-- Today's Schedule Card -->
        <rect x="0" y="0" width="310" height="205" rx="8" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
        <text x="14" y="22" font-family="system-ui, sans-serif" font-weight="800" font-size="12" fill="#0f172a">Today's Schedule</text>
        
        <!-- Schedule Rows -->
        <g transform="translate(14, 38)" font-family="system-ui, sans-serif" font-size="10">
          <!-- Row 1 -->
          <rect x="-6" y="-6" width="294" height="34" rx="4" fill="#f8fafc" />
          <text x="0" y="14" font-weight="700" fill="#0284c7">08:00 - 09:00</text>
          <text x="95" y="14" font-weight="800" fill="#1e293b">Mathematics</text>
          <text x="215" y="14" font-weight="700" fill="#64748b">Grade 7A</text>

          <!-- Row 2 -->
          <rect x="-6" y="32" width="294" height="34" rx="4" fill="#ffffff" />
          <text x="0" y="52" font-weight="700" fill="#0284c7">09:40 - 10:40</text>
          <text x="95" y="52" font-weight="800" fill="#1e293b">English</text>
          <text x="215" y="52" font-weight="700" fill="#64748b">Grade 7A</text>

          <!-- Row 3 -->
          <rect x="-6" y="70" width="294" height="34" rx="4" fill="#f8fafc" />
          <text x="0" y="90" font-weight="700" fill="#0284c7">11:20 - 12:20</text>
          <text x="95" y="90" font-weight="800" fill="#1e293b">Science</text>
          <text x="215" y="90" font-weight="700" fill="#64748b">Grade 7B</text>

          <!-- Row 4 -->
          <rect x="-6" y="108" width="294" height="34" rx="4" fill="#ffffff" />
          <text x="0" y="128" font-weight="700" fill="#0284c7">01:30 - 02:30</text>
          <text x="95" y="128" font-weight="800" fill="#1e293b">Social Studies</text>
          <text x="215" y="128" font-weight="700" fill="#64748b">Grade 7B</text>
        </g>

        <!-- Quick Links Card -->
        <g transform="translate(325, 0)">
          <rect x="0" y="0" width="175" height="205" rx="8" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
          <text x="14" y="22" font-family="system-ui, sans-serif" font-weight="800" font-size="12" fill="#0f172a">Quick Links</text>
          
          <g transform="translate(14, 40)" font-family="system-ui, sans-serif" font-size="10" font-weight="700" fill="#334155">
            <text x="0" y="14">🗓️ View Timetable</text>
            <text x="135" y="14" fill="#94a3b8">›</text>

            <text x="0" y="48">✏️ Create Assessment</text>
            <text x="135" y="48" fill="#94a3b8">›</text>

            <text x="0" y="82">📤 Share Resources</text>
            <text x="135" y="82" fill="#94a3b8">›</text>

            <text x="0" y="116">💬 Send Message</text>
            <text x="135" y="116" fill="#94a3b8">›</text>
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- ================= THE TEACHER: MR. GADAFFIH (CENTER-LEFT) ================= -->
  <g transform="translate(290, 60)">
    <!-- Shadow beneath teacher -->
    <ellipse cx="230" cy="620" rx="140" ry="24" fill="#0f172a" opacity="0.25" filter="url(#softGlow)" />

    <!-- 1. Legs / Trousers (Dark Navy Suit) -->
    <path d="M 175 490 L 155 640 L 210 640 L 225 500 Z" fill="#0f172a" />
    <path d="M 235 500 L 250 640 L 305 640 L 285 490 Z" fill="#090d16" />

    <!-- 2. Suit Jacket Torso -->
    <!-- White shirt inner collar -->
    <polygon points="210,180 250,180 230,280" fill="#ffffff" />
    
    <!-- Royal Blue Tie -->
    <polygon points="224,185 236,185 238,320 230,340 222,320" fill="url(#tieGrad)" />
    <!-- Diagonal micro pattern on tie -->
    <line x1="223" y1="210" x2="237" y2="200" stroke="#60a5fa" stroke-width="2" />
    <line x1="223" y1="235" x2="237" y2="225" stroke="#60a5fa" stroke-width="2" />
    <line x1="223" y1="260" x2="237" y2="250" stroke="#60a5fa" stroke-width="2" />
    <line x1="223" y1="285" x2="237" y2="275" stroke="#60a5fa" stroke-width="2" />

    <!-- Navy Tailored Suit Jacket -->
    <!-- Left Body & Lapel -->
    <path d="M 150 200 L 222 340 L 215 510 L 145 490 L 120 300 Z" fill="url(#suitGrad)" />
    <!-- Right Body & Lapel -->
    <path d="M 310 200 L 238 340 L 245 510 L 315 490 L 340 300 Z" fill="url(#suitGrad)" />
    <!-- Left Lapel Crisp Edge -->
    <polygon points="160,185 210,185 224,340 180,260" fill="#1e293b" stroke="#334155" stroke-width="1.5" />
    <!-- Right Lapel Crisp Edge -->
    <polygon points="300,185 250,185 236,340 280,260" fill="#1e293b" stroke="#334155" stroke-width="1.5" />

    <!-- Left Arm & Hand Holding Digital Tablet -->
    <!-- Upper Arm -->
    <path d="M 330 200 L 390 320 L 350 335 L 305 230 Z" fill="#0f172a" />
    <!-- Forearm bending forward -->
    <path d="M 390 320 L 350 430 L 320 410 L 350 335 Z" fill="#1e293b" />
    <!-- White shirt cuff -->
    <rect x="325" y="405" width="26" height="10" rx="2" fill="#ffffff" transform="rotate(-30 325 405)" />
    <!-- Hand holding tablet -->
    <ellipse cx="320" cy="425" rx="14" ry="12" fill="#8d5b4c" />
    <!-- Digital Tablet in Hand -->
    <g transform="translate(245, 360) rotate(20)">
      <rect x="0" y="0" width="110" height="78" rx="6" fill="#0f172a" stroke="#cbd5e1" stroke-width="2" filter="url(#cardShadow)" />
      <rect x="5" y="5" width="100" height="68" rx="3" fill="#0284c7" />
      <text x="55" y="38" font-family="system-ui, sans-serif" font-weight="900" font-size="11" fill="#ffffff" text-anchor="middle">EduSmart</text>
      <text x="55" y="52" font-family="system-ui, sans-serif" font-weight="700" font-size="8" fill="#dbeafe" text-anchor="middle">Teacher Portal</text>
    </g>

    <!-- Right Arm & Hand Pointing Stylus Forward -->
    <!-- Upper Arm -->
    <path d="M 130 200 L 80 320 L 120 335 L 160 220 Z" fill="#0f172a" />
    <!-- Forearm pointing forward -->
    <path d="M 80 320 L 130 370 L 150 345 L 120 335 Z" fill="#1e293b" />
    <!-- White shirt cuff -->
    <rect x="125" y="355" width="22" height="8" rx="2" fill="#ffffff" transform="rotate(30 125 355)" />
    <!-- Hand with fingers pointing -->
    <ellipse cx="145" cy="370" rx="12" ry="10" fill="#8d5b4c" />
    <!-- Black Stylus Pen pointing -->
    <line x1="140" y1="375" x2="190" y2="350" stroke="#0f172a" stroke-width="4" stroke-linecap="round" />
    <circle cx="190" cy="350" r="2.5" fill="#38bdf8" />

    <!-- 3. Head & Facial Features -->
    <!-- Neck -->
    <rect x="212" y="145" width="36" height="42" fill="#78493d" rx="4" />
    
    <!-- Head Base Oval -->
    <ellipse cx="230" cy="115" rx="36" ry="46" fill="#8d5b4c" />
    <!-- Jawline contour -->
    <path d="M 198 115 Q 230 168 262 115 Z" fill="#78493d" opacity="0.6" />

    <!-- Short Smart Haircut -->
    <path d="M 194 110 C 190 70, 270 70, 266 110 C 260 82, 200 82, 194 110 Z" fill="#090d16" />

    <!-- Ears -->
    <ellipse cx="193" cy="118" rx="6" ry="11" fill="#78493d" />
    <ellipse cx="267" cy="118" rx="6" ry="11" fill="#78493d" />

    <!-- Eyebrows -->
    <path d="M 206 102 Q 218 99 226 103" stroke="#090d16" stroke-width="3.5" fill="none" stroke-linecap="round" />
    <path d="M 234 103 Q 242 99 254 102" stroke="#090d16" stroke-width="3.5" fill="none" stroke-linecap="round" />

    <!-- Confident Eyes -->
    <ellipse cx="216" cy="112" rx="5" ry="3.5" fill="#ffffff" />
    <circle cx="217" cy="112" r="2.5" fill="#1e293b" />
    <ellipse cx="244" cy="112" rx="5" ry="3.5" fill="#ffffff" />
    <circle cx="243" cy="112" r="2.5" fill="#1e293b" />

    <!-- Black Rectangular Eyeglasses -->
    <rect x="204" y="104" width="22" height="16" rx="4" fill="none" stroke="#090d16" stroke-width="3" />
    <rect x="234" y="104" width="22" height="16" rx="4" fill="none" stroke="#090d16" stroke-width="3" />
    <line x1="226" y1="110" x2="234" y2="110" stroke="#090d16" stroke-width="3" />
    <line x1="204" y1="108" x2="194" y2="108" stroke="#090d16" stroke-width="2.5" />
    <line x1="256" y1="108" x2="266" y2="108" stroke="#090d16" stroke-width="2.5" />

    <!-- Nose & Warm Smile -->
    <path d="M 230 115 L 227 127 L 233 127" stroke="#683d33" stroke-width="2" fill="none" />
    <!-- Confident Smile -->
    <path d="M 220 138 Q 230 146 240 138" stroke="#4a2820" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <path d="M 222 138 Q 230 143 238 138" fill="#ffffff" />
  </g>

  <!-- ================= FOREGROUND STUDENTS & CLASSROOM DESKS ================= -->
  
  <!-- Desk Row 1 (Lower Foreground Table) -->
  <g transform="translate(0, 580)">
    <!-- Long Modern Wooden Desk Top -->
    <polygon points="0,150 1600,150 1600,240 0,240" fill="#e2d4be" stroke="#c5b297" stroke-width="4" filter="url(#cardShadow)" />
    <line x1="0" y1="160" x2="1600" y2="160" stroke="#ffffff" stroke-width="2" opacity="0.6" />

    <!-- STUDENT 1 (Far Left, Side Angle) -->
    <g transform="translate(60, -80)">
      <!-- Student Back/Shoulders (Navy Uniform) -->
      <path d="M 40 120 C 10 180, 150 180, 120 120 Z" fill="#0f172a" />
      <circle cx="80" cy="80" r="32" fill="#683d33" />
      <!-- Braided Hair -->
      <circle cx="80" cy="74" r="34" fill="#090d16" />
      
      <!-- Student Tablet on Stand (Left) -->
      <g transform="translate(130, 90)">
        <polygon points="10,65 50,65 30,5" fill="#64748b" />
        <rect x="0" y="0" width="130" height="90" rx="8" fill="#0f172a" stroke="#ffffff" stroke-width="3" filter="url(#cardShadow)" />
        <rect x="6" y="6" width="118" height="78" rx="4" fill="#0284c7" />
        <!-- App content on screen -->
        <text x="65" y="24" font-family="system-ui" font-size="9" font-weight="900" fill="#ffffff" text-anchor="middle">EduSmart</text>
        <rect x="16" y="32" width="40" height="18" rx="3" fill="#ffffff" fill-opacity="0.2" />
        <text x="36" y="44" font-family="system-ui" font-size="7" font-weight="700" fill="#ffffff" text-anchor="middle">My Courses</text>
        <rect x="64" y="32" width="48" height="18" rx="3" fill="#ffffff" fill-opacity="0.2" />
        <text x="88" y="44" font-family="system-ui" font-size="7" font-weight="700" fill="#ffffff" text-anchor="middle">Assignments</text>
        <rect x="16" y="56" width="40" height="18" rx="3" fill="#ffffff" fill-opacity="0.2" />
        <text x="36" y="68" font-family="system-ui" font-size="7" font-weight="700" fill="#ffffff" text-anchor="middle">Resources</text>
        <rect x="64" y="56" width="48" height="18" rx="3" fill="#ffffff" fill-opacity="0.2" />
        <text x="88" y="68" font-family="system-ui" font-size="7" font-weight="700" fill="#ffffff" text-anchor="middle">Grades</text>
      </g>
    </g>

    <!-- STUDENT 2 (Center-Left Foreground, Focused on Learning App) -->
    <g transform="translate(420, -50)">
      <!-- Shoulders & Back (Navy Blazer & White Collar) -->
      <path d="M 60 140 C 20 230, 260 230, 220 140 Z" fill="#0f172a" />
      <polygon points="130,135 150,135 140,155" fill="#ffffff" />
      <circle cx="140" cy="90" r="42" fill="#78493d" />
      <circle cx="140" cy="84" r="44" fill="#090d16" />

      <!-- Centered Tablet: EduSmart My Learning -->
      <g transform="translate(190, 80)">
        <polygon points="20,80 80,80 50,10" fill="#475569" />
        <rect x="0" y="0" width="170" height="115" rx="10" fill="#090d16" stroke="#ffffff" stroke-width="4" filter="url(#cardShadow)" />
        <rect x="8" y="8" width="154" height="99" rx="6" fill="#f8fafc" />
        
        <!-- Header -->
        <g transform="translate(16, 14)">
          <text x="0" y="10" font-family="system-ui" font-size="10" font-weight="900" fill="#0284c7">Edu<tspan fill="#f59e0b">Smart</tspan></text>
          <text x="0" y="24" font-family="system-ui" font-size="9" font-weight="800" fill="#0f172a">My Learning</text>
        </g>

        <!-- 4 Action Tiles on student tablet -->
        <g transform="translate(16, 44)">
          <rect x="0" y="0" width="28" height="34" rx="4" fill="#3b82f6" />
          <text x="14" y="22" font-size="12" text-anchor="middle">📱</text>
          <text x="14" y="44" font-family="system-ui" font-size="5" font-weight="800" fill="#475569" text-anchor="middle">eLearning</text>

          <rect x="36" y="0" width="28" height="34" rx="4" fill="#10b981" />
          <text x="50" y="22" font-size="12" text-anchor="middle">📝</text>
          <text x="50" y="44" font-family="system-ui" font-size="5" font-weight="800" fill="#475569" text-anchor="middle">Tasks</text>

          <rect x="72" y="0" width="28" height="34" rx="4" fill="#f59e0b" />
          <text x="86" y="22" font-size="12" text-anchor="middle">📂</text>
          <text x="86" y="44" font-family="system-ui" font-size="5" font-weight="800" fill="#475569" text-anchor="middle">Notes</text>

          <rect x="108" y="0" width="28" height="34" rx="4" fill="#8b5cf6" />
          <text x="122" y="22" font-size="12" text-anchor="middle">🏆</text>
          <text x="122" y="44" font-family="system-ui" font-size="5" font-weight="800" fill="#475569" text-anchor="middle">Grades</text>
        </g>
      </g>
    </g>

    <!-- STUDENT 3 (Center-Right, Learning CBC Mathematics) -->
    <g transform="translate(860, -90)">
      <!-- Shoulders & Back -->
      <path d="M 40 130 C 10 200, 190 200, 160 130 Z" fill="#0f172a" />
      <circle cx="100" cy="85" r="36" fill="#683d33" />
      <circle cx="100" cy="80" r="38" fill="#090d16" />

      <!-- Student Tablet: CBC Mathematics with Geometry -->
      <g transform="translate(130, 95)">
        <rect x="0" y="0" width="145" height="100" rx="8" fill="#090d16" stroke="#ffffff" stroke-width="3.5" filter="url(#cardShadow)" />
        <rect x="6" y="6" width="133" height="88" rx="5" fill="#f8fafc" />
        
        <!-- Header -->
        <text x="12" y="20" font-family="system-ui" font-size="9" font-weight="900" fill="#0284c7">EduSmart</text>
        <text x="12" y="32" font-family="system-ui" font-size="10" font-weight="800" fill="#0f172a">Mathematics</text>

        <!-- Geometry Shapes Illustration on Screen -->
        <g transform="translate(12, 40)">
          <!-- Animated Teacher Video in corner -->
          <rect x="0" y="0" width="46" height="42" rx="4" fill="#0284c7" />
          <circle cx="23" cy="18" r="10" fill="#ffffff" />
          <text x="23" y="22" font-size="9" text-anchor="middle">👨🏾‍🏫</text>

          <!-- Interactive Geometry Triangle & Angles -->
          <polygon points="65,38 95,5 125,38" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" />
          <circle cx="105" cy="22" r="10" fill="none" stroke="#f59e0b" stroke-width="2" />
          <line x1="65" y1="38" x2="125" y2="38" stroke="#0284c7" stroke-width="2" />
        </g>
      </g>
    </g>

    <!-- STUDENT 4 (Far Right, Video Lesson) -->
    <g transform="translate(1220, -70)">
      <!-- Shoulders & Back -->
      <path d="M 50 130 C 15 200, 195 200, 160 130 Z" fill="#0f172a" />
      <circle cx="105" cy="85" r="38" fill="#78493d" />
      <circle cx="105" cy="78" r="40" fill="#090d16" />

      <!-- Video Tablet -->
      <g transform="translate(80, 105)">
        <rect x="0" y="0" width="130" height="90" rx="8" fill="#0f172a" stroke="#ffffff" stroke-width="3" filter="url(#cardShadow)" />
        <rect x="6" y="6" width="118" height="78" rx="4" fill="#0284c7" />
        <text x="65" y="24" font-family="system-ui" font-size="9" font-weight="900" fill="#ffffff" text-anchor="middle">EduSmart Video</text>
        <!-- Big Play Button -->
        <circle cx="65" cy="48" r="16" fill="#ffffff" />
        <polygon points="61,40 73,48 61,56" fill="#0284c7" />
      </g>
    </g>
  </g>

  <!-- High-Tech Bottom Accent Light Bar -->
  <rect x="0" y="894" width="1600" height="6" fill="url(#cardBlue)" />
</svg>
